{
    "folders": [
        {
            "path": "App"
        },
        {
            "path": "Test"
        }
    ],
    "settings": {
        "CRS.ObjectNamePrefix": "EDK ",
        "CRS.RemovePrefixFromFilename": true,
        "CRS.RemoveSuffixFromFilename": true,
        "CRS.FileNamePattern": "<ObjectNameShort>.<ObjectType>.al",
        "CRS.FileNamePatternExtensions": "<ObjectNameShort>.<ObjectType>.ext.al",
        "CRS.OnSaveAlFileAction": "Reorganize",
        "al.ruleSetPath": ".\\EDK.ruleset.json",
        "al.enableCodeAnalysis": true,
        "al.codeAnalyzers": [
            "${CodeCop}",
            "${PerTenantExtensionCop}",
            "${UICop}",
            "${analyzerFolder}ALCops.ApplicationCop.dll",
            "${analyzerFolder}ALCops.DocumentationCop.dll",
            "${analyzerFolder}ALCops.FormattingCop.dll",
            "${analyzerFolder}ALCops.LinterCop.dll",
            "${analyzerFolder}ALCops.PlatformCop.dll",
            "${analyzerFolder}ALCops.TestAutomationCop.dll",
            "${analyzerFolder}ALCops.Common.dll"
        ]
    }
}
